{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "global-official-business-facts",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_do_not_populate_process_env"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "alias": {
    "uncrypto": "./src/compat/uncrypto-worker.ts"
  },
  "vars": {
    "PUBLIC_HOSTNAME": "business.newbies.cool"
  },
  "secrets": {
    "required": [
      "CDP_API_KEY_ID",
      "CDP_API_KEY_SECRET"
    ]
  },
  "ratelimits": [
    {
      "name": "REQUEST_RATE_LIMITER",
      "namespace_id": "7482301",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "UPSTREAM_RATE_LIMITER",
      "namespace_id": "7482302",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "SINGAPORE_SOURCE_RATE_LIMITER",
      "namespace_id": "7482303",
      "simple": {
        "limit": 4,
        "period": 10
      }
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "persist": true
    }
  }
}
