{
  "name": "global-official-business-facts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "validate:catalogue": "node --import tsx scripts/validate-catalogue.ts",
    "build:catalogue": "node --import tsx scripts/build-catalogue.ts",
    "build:static": "node --import tsx scripts/build-static.ts",
    "build": "npm run validate:catalogue && npm run build:catalogue && npm run build:static",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:security": "vitest run tests/security.test.ts tests/catalogue-security.test.ts tests/adversarial.test.ts",
    "test:x402:testnet": "node --import tsx scripts/x402-testnet-smoke.ts",
    "test:adapters:live": "node --import tsx scripts/live-adapter-smoke.ts",
    "check": "npm run build && npm run types:worker && npm run typecheck && npm test && wrangler deploy --dry-run",
    "dev": "npm run build && npm run types:worker && wrangler dev",
    "deploy": "npm run check && wrangler deploy",
    "types:worker": "wrangler types --include-runtime=false"
  },
  "dependencies": {
    "@coinbase/cdp-sdk": "1.55.0",
    "@coinbase/x402": "2.1.0",
    "@x402/core": "2.22.0",
    "@x402/evm": "2.22.0",
    "@x402/extensions": "2.22.0",
    "@x402/svm": "2.22.0",
    "hono": "4.13.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260814.1",
    "@types/node": "26.2.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "wrangler": "4.123.0"
  },
  "overrides": {
    "axios": "1.19.0"
  },
  "engines": {
    "node": ">=22"
  }
}
